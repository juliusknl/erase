# On macOS use: uv run erasure-keychain init (leave these three values empty).
# For manual process configuration, generate all three with: uv run erasure-secrets
ERASURE_MASTER_KEY=
ERASURE_PASSWORD_HASH=
ERASURE_SESSION_SECRET=
ERASURE_DATABASE_URL=sqlite:///./data/erasure.db
ERASURE_BASE_URL=http://127.0.0.1:8787
ERASURE_LIVE_SUBMISSIONS=false

# Optional here: the guided setup can import and encrypt your Google client JSON instead.
# Create a Web application OAuth client in Google Cloud and use a dedicated Gmail account.
# Authorized redirect URI: http://127.0.0.1:8787/gmail/callback
ERASURE_GOOGLE_CLIENT_ID=
ERASURE_GOOGLE_CLIENT_SECRET=

# Optional AI reply interpretation. Opt-in sends minimized broker replies to TypeSafe.
# Existing local rules continue to work without this. Restart after changing.
ERASURE_JEV_ENABLED=false
TYPESAFE_API_KEY=
